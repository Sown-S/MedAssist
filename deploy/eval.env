# Cấu hình môi trường kiểm thử 1 máy (deploy/docker-compose.eval.yml). Chỉ dùng trên máy kiểm thử, không cho phòng khám.
# Sửa xong chạy lại lệnh "up -d" để áp dụng.

# Mật khẩu chung của các tài khoản mẫu admin, bs01, bs02, letan01 (đặt lần đầu nạp dữ liệu)
EVAL_PASSWORD=Kiemthu@2026

# AI gợi ý chẩn đoán:
#   none   = chỉ xếp hạng theo luật (Rule-only), không cần cài gì thêm (mặc định)
#   ollama = dùng LLM thật: cài Ollama trên máy này, chạy "ollama pull <model bên dưới>", rồi đổi thành ollama
EVAL_LLM_PROVIDER=none
EVAL_OLLAMA_MODEL=hf.co/aisingapore/Gemma-SEA-LION-v3-9B-IT-GGUF:Q4_K_M
EVAL_OLLAMA_URL=http://host.docker.internal:11434
