# Sao chép thành deploy/.env (KHÔNG commit file .env)
POSTGRES_PASSWORD=doi_mat_khau_superuser
MEDASSIST_OWNER_PASSWORD=doi_mat_khau_owner
MEDASSIST_APP_PASSWORD=doi_mat_khau_app
MEDASSIST_BACKUP_PASSWORD=doi_mat_khau_backup
MEDASSIST_CREATE_EVAL_DB=0
MEDASSIST_CREATE_TEST_DB=1

# --- Chỉ máy admin (deploy/docker-compose.yml) ---
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu
# Một model cho cả trích xuất và reasoning; start.ps1 tự tải về lần đầu (5.8 GB)
OLLAMA_MODEL=hf.co/aisingapore/Gemma-SEA-LION-v3-9B-IT-GGUF:Q4_K_M
# JSON. Nguồn giao diện được gọi API (bản Electron đóng gói). Để [] nếu client không gửi Origin
CORS_ORIGINS=[]
# Tùy chọn: đổi phiên bản Ollama (mặc định bản Huy đã chạy thử)
#OLLAMA_IMAGE=ollama/ollama:0.34.4
