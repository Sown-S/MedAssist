# Sao chép thành server/.env (KHÔNG commit). Mật khẩu khớp deploy/.env
ENVIRONMENT=dev
# API, worker, script nạp OKF — vai trò medassist_app:
DATABASE_URL=postgresql+psycopg://medassist_app:doi_mat_khau_app@127.0.0.1:5432/medassist
# CHỈ Alembic dùng — vai trò medassist_owner:
MIGRATION_DATABASE_URL=postgresql+psycopg://medassist_owner:doi_mat_khau_owner@127.0.0.1:5432/medassist
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu
# JSON. Đổi khi biết client Electron tải giao diện từ đâu
#CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
#LOG_LEVEL=INFO
# --- AI (worker: python -m app.worker) ---
# Máy không có Ollama: LLM_PROVIDER=fake (LLM giả lập, đủ luồng Ready/Full, cấm ở prod)
# hoặc LLM_PROVIDER=none (chỉ còn xếp hạng tất định Degraded/RuleOnly)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=aisingapore/Gemma-SEA-LION-v3-9B-IT
