{
  "name": "medassist-app",
  "version": "0.2.5",
  "description": "MedAssist — Clinical Decision Support System for Outpatient Clinics (Electron + React desktop client)",
  "main": "./out/main/index.js",
  "author": "C1SE.28",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "eval": "electron-vite preview --mode eval",
    "smoke": "electron-vite build --mode eval && node scripts/smoke.mjs",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dist:eval": "electron-vite build --mode eval && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/renderer/**/*.css\" --max-warnings 0",
    "e2e": "electron-vite build --mode eval && playwright test",
    "e2e:update": "playwright test e2e/visual.spec.mjs e2e/print.spec.mjs --update-snapshots"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.57",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "espree": "^10.4.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "stylelint": "^16.26.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "productName": "MedAssist",
  "build": {
    "appId": "vn.edu.dtu.c1se28.medassist",
    "productName": "MedAssist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "certs",
        "to": "certs",
        "filter": [
          "*.crt",
          "*.pem"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MedAssist-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "identity": null,
      "artifactName": "MedAssist-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
